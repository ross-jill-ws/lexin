{
  "name": "@material-register/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@material-register/shared": "workspace:*",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  }
}
